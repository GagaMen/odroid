#!/usr/bin/env python3
"""Export available snap refreshes as node_exporter textfile metrics.

Talks to snapd over its REST socket rather than parsing CLI output. The socket is
world-readable, so this runs unprivileged, and read-only queries need no rights.
"""

import http.client
import json
import os
import re
import socket
import sys
import tempfile
import urllib.parse

SOCKET = "/run/snapd.socket"
OUT = os.environ.get(
    "TEXTFILE_DIR", "/var/lib/prometheus/node-exporter"
) + "/snap.prom"


class UnixHTTPConnection(http.client.HTTPConnection):
    """http.client over a unix domain socket."""

    def __init__(self, path, timeout=30):
        super().__init__("localhost", timeout=timeout)
        self.path = path

    def connect(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        sock.connect(self.path)
        self.sock = sock


def snapd_get(endpoint):
    conn = UnixHTTPConnection(SOCKET)
    try:
        conn.request("GET", endpoint)
        response = conn.getresponse()
        body = json.load(response)
    finally:
        conn.close()
    if body.get("status-code") != 200:
        raise RuntimeError(f"{endpoint} returned {body.get('status-code')}")
    return body.get("result") or []


def store_channels(name):
    """Channel map the store offers for a snap, or None if it cannot be resolved.

    This queries the store, so it fails when the machine is offline.
    """
    query = urllib.parse.urlencode({"name": name})
    try:
        result = snapd_get(f"/v2/find?{query}")
    except Exception:  # noqa: BLE001 - offline or unknown snap, not fatal
        return None
    if not result:
        return None
    return result[0].get("channels", {})


def version_track(track):
    """A track such as "1.36" as a comparable tuple, or None for "latest" and the like."""
    if not re.fullmatch(r"\d+(\.\d+)*", track or ""):
        return None
    return tuple(int(part) for part in track.split("."))


def newest_stable_track(channels, current):
    """The highest version track with a stable channel, if it is newer than current.

    Tracks with a suffix, such as 1.36-strict, are a different packaging of the same
    version and do not count.
    """
    newest = None
    for channel in channels:
        track, _, risk = channel.partition("/")
        version = version_track(track)
        if risk == "stable" and version and (newest is None or version > newest[0]):
            newest = (version, track)
    if newest and newest[0] > version_track(current):
        return newest[1]
    return None


def collect():
    installed = snapd_get("/v2/snaps")

    # Candidates snapd itself considers refreshable - the same source as
    # "snap refresh --list".
    try:
        pending = {s["name"] for s in snapd_get("/v2/find?select=refresh")}
    except Exception:  # noqa: BLE001 - offline; fall back to the per-snap check
        pending = set()

    rows = []
    tracks = []
    for snap in installed:
        name = snap["name"]
        held = "hold" in snap
        available = name in pending

        # Use "channel" rather than "tracking-channel": a snap may track a branch
        # such as 4.0/stable/ubuntu-24.04, which the channel map does not list,
        # while "channel" holds the resolved track/risk pair.
        channel = snap.get("channel") or ""
        track = channel.partition("/")[0]
        channels = None

        # A held snap may be omitted from the refresh candidates, and a held snap is
        # exactly the one whose updates must not go unnoticed. Check it directly.
        if held and not available and channel:
            channels = store_channels(name)
            entry = (channels or {}).get(channel)
            offered = entry.get("revision") if entry else None
            if offered is not None and str(offered) != str(snap.get("revision")):
                available = True

        # A snap on a version track, such as microk8s on 1.36, only ever receives
        # updates within that track. A new major or minor version opens a new track,
        # which a refresh never moves to by itself.
        if version_track(track):
            if channels is None:
                channels = store_channels(name)
            if channels is not None:
                tracks.append((name, held, track, newest_stable_track(channels, track)))

        rows.append((name, held, available))
    return sorted(rows), sorted(tracks)


def main():
    try:
        rows, tracks = collect()
    except Exception as exc:  # noqa: BLE001 - a snapd hiccup must not kill the timer
        print(f"querying snapd failed: {exc}", file=sys.stderr)
        return 1

    lines = [
        "# HELP snap_refresh_available Whether a newer revision is available on the tracked channel.",
        "# TYPE snap_refresh_available gauge",
    ]
    for name, held, available in rows:
        lines.append(
            f'snap_refresh_available{{snap="{name}",held="{int(held)}"}} {int(available)}'
        )

    lines += [
        "# HELP snap_newer_track_available Whether a newer version track than the tracked one offers a stable channel.",
        "# TYPE snap_newer_track_available gauge",
    ]
    for name, held, track, newest in tracks:
        lines.append(
            f'snap_newer_track_available{{snap="{name}",held="{int(held)}",'
            f'track="{track}",newest="{newest or track}"}} {int(newest is not None)}'
        )

    lines += [
        "# HELP node_watchdog_present Whether a hardware watchdog device is exposed.",
        "# TYPE node_watchdog_present gauge",
        f"node_watchdog_present {int(os.path.exists('/dev/watchdog'))}",
    ]

    directory = os.path.dirname(OUT)
    with tempfile.NamedTemporaryFile(
        "w", dir=directory, prefix=".snap.prom.", delete=False
    ) as handle:
        handle.write("\n".join(lines) + "\n")
        temporary = handle.name
    os.chmod(temporary, 0o644)
    os.replace(temporary, OUT)
    return 0


if __name__ == "__main__":
    sys.exit(main())
