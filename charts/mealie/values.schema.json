{
  "$ref": "#/definitions/Values",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Values": {
      "additionalProperties": false,
      "properties": {
        "affinity": {
          "description": "Affinity rules for pod assignment",
          "type": "object"
        },
        "bring": {
          "additionalProperties": false,
          "description": "Sidecar that pushes ingredients to a Bring! list",
          "properties": {
            "enabled": {
              "description": "Run the mealie-bring-api sidecar",
              "type": "boolean"
            },
            "image": {
              "additionalProperties": false,
              "properties": {
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ],
                  "type": "string"
                },
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "listName": {
              "description": "Exact name of the target Bring list (BRING_LIST_NAME)",
              "type": "string"
            },
            "mealieApiKey": {
              "description": "Mealie API key; enables moving shopping lists to Bring (MEALIE_API_KEY)",
              "type": "string"
            },
            "password": {
              "description": "Bring account password (BRING_PASSWORD)",
              "type": "string"
            },
            "port": {
              "description": "Port the bridge listens on, on 127.0.0.1",
              "type": "integer"
            },
            "resources": {
              "additionalProperties": false,
              "properties": {
                "limits": {
                  "additionalProperties": false,
                  "description": "CPU/memory resource limits",
                  "properties": {
                    "cpu": {
                      "type": "string"
                    },
                    "memory": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "requests": {
                  "additionalProperties": false,
                  "description": "CPU/memory resource requests",
                  "properties": {
                    "cpu": {
                      "type": "string"
                    },
                    "memory": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "shoppingListUuid": {
              "description": "Only move items of this Mealie shopping list (MEALIE_SHOPPING_LIST_UUID)",
              "type": "string"
            },
            "username": {
              "description": "Bring account email (BRING_USERNAME)",
              "type": "string"
            }
          },
          "type": "object"
        },
        "config": {
          "additionalProperties": false,
          "description": "Settings handed to the container as environment variables",
          "properties": {
            "allowSignup": {
              "description": "Allow sign-up without an invitation (ALLOW_SIGNUP)",
              "type": "boolean"
            },
            "baseUrl": {
              "description": "Public URL without trailing slash (BASE_URL); empty means derived from the first ingress host",
              "type": "string"
            },
            "httpAllowList": {
              "description": "Private hosts or CIDRs Mealie may reach (HTTP_ALLOW_LIST); the Bring bridge is added automatically",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "timeZone": {
              "description": "IANA time zone (TZ)",
              "type": "string"
            }
          },
          "type": "object"
        },
        "enabled": {
          "description": "Enable/disable this chart (used by platform condition)",
          "type": "boolean"
        },
        "env": {
          "description": "Additional environment variables for the mealie container",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "fullnameOverride": {
          "description": "Override the full release name",
          "type": "string"
        },
        "global": {
          "description": "Injected by Helm for sub-chart coordination",
          "type": "object"
        },
        "image": {
          "additionalProperties": false,
          "description": "Container image configuration",
          "properties": {
            "pullPolicy": {
              "description": "Image pull policy",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "type": "string"
            },
            "repository": {
              "description": "Container image repository",
              "type": "string"
            },
            "tag": {
              "description": "Overrides the image tag whose default is the chart appVersion",
              "type": "string"
            }
          },
          "type": "object"
        },
        "ingress": {
          "additionalProperties": false,
          "description": "Ingress configuration",
          "properties": {
            "annotations": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Ingress annotations",
              "type": "object"
            },
            "className": {
              "description": "Ingress class name",
              "type": "string"
            },
            "enabled": {
              "description": "Enable ingress",
              "type": "boolean"
            },
            "hosts": {
              "description": "Ingress host rules",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "enum": [
                            "Prefix",
                            "Exact",
                            "ImplementationSpecific"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "tls": {
              "description": "Ingress TLS configuration",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "hosts": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "secretName": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "livenessProbe": {
          "additionalProperties": false,
          "description": "Liveness probe configuration",
          "properties": {
            "failureThreshold": {
              "type": "integer"
            },
            "httpGet": {
              "additionalProperties": false,
              "properties": {
                "httpHeaders": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "path": {
                  "type": "string"
                },
                "port": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "type": "object"
            },
            "initialDelaySeconds": {
              "type": "integer"
            },
            "periodSeconds": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "nameOverride": {
          "description": "Override the chart name",
          "type": "string"
        },
        "namespaceOverride": {
          "description": "Override the deployment namespace",
          "type": "string"
        },
        "nodeSelector": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Node selector for pod assignment",
          "type": "object"
        },
        "persistence": {
          "additionalProperties": false,
          "description": "Persistent Volume Claims",
          "properties": {
            "data": {
              "additionalProperties": false,
              "description": "SQLite database, recipe images, backups",
              "properties": {
                "accessMode": {
                  "description": "PVC access mode",
                  "enum": [
                    "ReadWriteOnce",
                    "ReadOnlyMany",
                    "ReadWriteMany"
                  ],
                  "type": "string"
                },
                "enabled": {
                  "description": "Enable persistent volume",
                  "type": "boolean"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Labels for the PVC",
                  "type": "object"
                },
                "size": {
                  "description": "Volume size (e.g. 500Mi, 2Gi)",
                  "pattern": "^[0-9]+(Mi|Gi|Ti)$",
                  "type": "string"
                },
                "storageClass": {
                  "description": "Storage class name",
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "readinessProbe": {
          "additionalProperties": false,
          "description": "Readiness probe configuration",
          "properties": {
            "failureThreshold": {
              "type": "integer"
            },
            "httpGet": {
              "additionalProperties": false,
              "properties": {
                "httpHeaders": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "path": {
                  "type": "string"
                },
                "port": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "type": "object"
            },
            "initialDelaySeconds": {
              "type": "integer"
            },
            "periodSeconds": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "resources": {
          "additionalProperties": false,
          "description": "CPU/memory resource requests and limits",
          "properties": {
            "limits": {
              "additionalProperties": false,
              "description": "CPU/memory resource limits",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "requests": {
              "additionalProperties": false,
              "description": "CPU/memory resource requests",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "service": {
          "additionalProperties": false,
          "description": "Service configuration",
          "properties": {
            "port": {
              "description": "Service port number (the container always listens on 9000)",
              "type": "integer"
            },
            "type": {
              "description": "Service type",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer",
                "ExternalName"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "startupProbe": {
          "additionalProperties": false,
          "description": "Startup probe configuration",
          "properties": {
            "failureThreshold": {
              "type": "integer"
            },
            "httpGet": {
              "additionalProperties": false,
              "properties": {
                "httpHeaders": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "path": {
                  "type": "string"
                },
                "port": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "type": "object"
            },
            "initialDelaySeconds": {
              "type": "integer"
            },
            "periodSeconds": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "strategy": {
          "additionalProperties": false,
          "description": "Deployment update strategy -- Recreate, because two pods would write the same SQLite file",
          "properties": {
            "rollingUpdate": {
              "type": "object"
            },
            "type": {
              "enum": [
                "Recreate",
                "RollingUpdate"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "tolerations": {
          "description": "Tolerations for pod assignment",
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  }
}