#!/usr/bin/env python3
"""Print the secret Helm values of the platform release, read from Bitwarden.

Usage (from anywhere): scripts/secrets-values

Resolves every reference in secrets/mapping.yaml against the Bitwarden vault
the `bw` CLI is logged into and prints the result as a YAML values file. The
vault must be unlocked:

  export BW_SESSION=$(npx bw unlock --raw)

Fails without printing anything if any reference cannot be resolved, so a
partial set of secrets never reaches Helm. Error messages name items and
fields, never their values.
"""
import json
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
MAPPING = ROOT / "secrets" / "mapping.yaml"


def bw(*args):
    result = subprocess.run(
        ["npx", "--no-install", "bw", "--nointeraction", *args],
        cwd=ROOT, capture_output=True, text=True)
    if result.returncode:
        sys.exit(f"bw {args[0]} failed: {result.stderr.strip()}")
    return result.stdout


def is_reference(node):
    return isinstance(node, dict) and set(node) == {"item", "field"}


def field_value(item, field):
    if field in ("username", "password"):
        return (item.get("login") or {}).get(field)
    if field == "notes":
        return item.get("notes")
    custom = [f for f in item.get("fields") or [] if f.get("name") == field]
    if len(custom) > 1:
        sys.exit(f"item {item['name']!r} has more than one custom field {field!r}")
    if not custom:
        present = [f.get("name") for f in item.get("fields") or []]
        sys.exit(f"item {item['name']!r} has no field {field!r}; custom fields present: {present}")
    return custom[0].get("value")


def resolve(node, items):
    if is_reference(node):
        name, field = node["item"], node["field"]
        if name not in items:
            sys.exit(f"no Bitwarden item named exactly {name!r}")
        if len(items[name]) > 1:
            sys.exit(f"{len(items[name])} Bitwarden items are named {name!r}; names must be unique")
        value = field_value(items[name][0], field)
        if not value:
            sys.exit(f"field {field!r} of item {name!r} is empty")
        return value
    if isinstance(node, dict):
        return {key: resolve(child, items) for key, child in node.items()}
    if isinstance(node, list):
        return [resolve(child, items) for child in node]
    sys.exit(f"{MAPPING.name}: expected a {{item, field}} reference, got {node!r}")


def main():
    mapping = yaml.safe_load(MAPPING.read_text())
    status = json.loads(bw("status"))["status"]
    if status != "unlocked":
        sys.exit(f"Bitwarden vault is {status}; run: export BW_SESSION=$(npx bw unlock --raw)")
    bw("sync")

    items = {}
    for item in json.loads(bw("list", "items")):
        items.setdefault(item["name"], []).append(item)

    print(yaml.safe_dump(resolve(mapping, items), sort_keys=False), end="")


if __name__ == "__main__":
    main()
